# Copiá este archivo como .env y completá los valores

# --- Aplicación ---
PORT=8000
NODE_ENV=development
APP_NAME=AvesBA API
APP_VERSION=1.0.0
# Orígenes del front que pueden llamar a la API (separados por coma)
CORS_ORIGIN=http://localhost:5173

# --- Persistencia: memory (se borra al reiniciar) o sequelize (SQLite en database.sqlite) ---
PERSISTENCE_TYPE=sequelize
DB_STORAGE=./database.sqlite

# --- Notificaciones: console, file (notifications.log) o none ---
NOTIFIER_TYPE=console

# --- Aves: inaturalist (necesita internet) o fake (15 aves de prueba) ---
BIRDS_PROVIDER=inaturalist

# --- Seguridad ---
# Obligatorio: sin JWT_SECRET la app no arranca. Usá un texto largo y difícil de adivinar.
JWT_SECRET=cambiame-por-un-secreto-largo-y-dificil
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Datos iniciales ---
ADMIN_EMAIL=admin@avesba.com
ADMIN_PASSWORD=admin12345
# Jugadores de prueba con partidas (0 = no cargar ninguno)
SEED_PLAYERS=100
SEED_PLAYERS_PASSWORD=Jugador123
